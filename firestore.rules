rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAssistant() {
      return hasRole('asisten');
    }

    function isPractikan() {
      return hasRole('praktikan');
    }

    function assistantForClass(classId) {
      let classPath = /databases/$(database)/documents/kelas/$(classId);
      return isAssistant()
        && exists(classPath)
        && request.auth.uid in get(classPath).data.asistenUids;
    }

    function practikanInClass(classId) {
      let classPath = /databases/$(database)/documents/kelas/$(classId);
      return isPractikan()
        && exists(classPath)
        && request.auth.uid in get(classPath).data.praktikanUids;
    }

    function activePractikanInClass(classId) {
      let participantPath = /databases/$(database)/documents/kelas/$(classId)/peserta/$(request.auth.uid);
      return practikanInClass(classId)
        && exists(participantPath)
        && get(participantPath).data.aktif == true;
    }

    function assistantForSession(sesiId) {
      let sessionPath = /databases/$(database)/documents/sesi/$(sesiId);
      return isAssistant()
        && exists(sessionPath)
        && assistantForClass(get(sessionPath).data.kelasId);
    }

    function practikanInSession(sesiId) {
      let sessionPath = /databases/$(database)/documents/sesi/$(sesiId);
      return isPractikan()
        && exists(sessionPath)
        && practikanInClass(get(sessionPath).data.kelasId);
    }

    function validPraktikumCreate() {
      return request.resource.data.keys().hasAll([
          'nama', 'deskripsi', 'aktif', 'praktikanUids', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'nama', 'deskripsi', 'aktif', 'praktikanUids', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.nama is string
        && request.resource.data.deskripsi is string
        && request.resource.data.aktif is bool
        && request.resource.data.praktikanUids is list
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validKelasCreate() {
      return request.resource.data.keys().hasAll([
          'praktikumId', 'nama', 'asistenUids', 'praktikanUids',
          'aktif', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'praktikumId', 'nama', 'asistenUids', 'praktikanUids',
          'aktif', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.praktikumId is string
        && exists(/databases/$(database)/documents/praktikum/$(request.resource.data.praktikumId))
        && request.resource.data.nama is string
        && request.resource.data.asistenUids is list
        && request.resource.data.praktikanUids is list
        && request.auth.uid in request.resource.data.asistenUids
        && request.resource.data.aktif is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validJadwal(data) {
      return data.keys().hasAll([
          'kelasId', 'pertemuanKe', 'tanggal', 'jamMulai',
          'jamSelesai', 'lokasi', 'aktif'
        ])
        && data.keys().hasOnly([
          'kelasId', 'pertemuanKe', 'tanggal', 'jamMulai',
          'jamSelesai', 'lokasi', 'aktif'
        ])
        && data.kelasId is string
        && data.pertemuanKe is int
        && data.tanggal is string
        && data.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.jamMulai is string
        && data.jamMulai.matches('^[0-9]{2}:[0-9]{2}$')
        && data.jamSelesai is string
        && data.jamSelesai.matches('^[0-9]{2}:[0-9]{2}$')
        && data.lokasi is string
        && data.aktif is bool;
    }

    function validPengajuanCreate(uid, sesiId) {
      let sessionPath = /databases/$(database)/documents/sesi/$(sesiId);
      return isPractikan()
        && request.auth.uid == uid
        && exists(sessionPath)
        && activePractikanInClass(get(sessionPath).data.kelasId)
        && get(sessionPath).data.status != 'ditutup'
        && !exists(/databases/$(database)/documents/sesi/$(sesiId)/presensi/$(uid))
        && request.resource.data.keys().hasAll([
          'userId', 'alasan', 'statusKlasifikasi', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'alasan', 'kategoriAI', 'statusKlasifikasi', 'status', 'createdAt'
        ])
        && request.resource.data.userId == uid
        && request.resource.data.alasan is string
        && request.resource.data.alasan.size() >= 10
        && request.resource.data.alasan.size() <= 500
        && request.resource.data.statusKlasifikasi in ['berhasil', 'gagal']
        && request.resource.data.status == 'menunggu'
        && request.resource.data.createdAt == request.time
        && (!('kategoriAI' in request.resource.data)
          || request.resource.data.kategoriAI is string);
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'nama', 'email', 'role', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'nama', 'email', 'role', 'nim', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.role == 'praktikan'
        && request.resource.data.createdAt == request.time
        && (!('nim' in request.resource.data)
          || request.resource.data.nim is string);

      allow update, delete: if false;
    }

    match /praktikum/{praktikumId} {
      allow read: if isAssistant()
        || (isPractikan()
          && request.auth.uid in resource.data.praktikanUids);

      allow create: if isAssistant() && validPraktikumCreate();

      allow update: if isAssistant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nama', 'deskripsi', 'aktif', 'praktikanUids', 'updatedAt'
        ])
        && request.resource.data.nama is string
        && request.resource.data.deskripsi is string
        && request.resource.data.aktif is bool
        && request.resource.data.praktikanUids is list
        && request.resource.data.praktikanUids.hasAll(resource.data.praktikanUids)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /kelas/{classId} {
      allow read: if (isAssistant()
          && request.auth.uid in resource.data.asistenUids)
        || (isPractikan()
          && request.auth.uid in resource.data.praktikanUids);

      allow create: if isAssistant()
        && validKelasCreate();

      allow update: if assistantForClass(classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nama', 'praktikanUids', 'aktif', 'updatedAt'
        ])
        && request.resource.data.nama is string
        && request.resource.data.praktikanUids is list
        && request.resource.data.praktikanUids.hasAll(resource.data.praktikanUids)
        && request.resource.data.aktif is bool
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /peserta/{uid} {
        allow get, list: if assistantForClass(classId)
          || (isPractikan() && request.auth.uid == uid);

        allow create: if assistantForClass(classId)
          && request.resource.data.keys().hasAll([
            'uid', 'nama', 'aktif', 'joinedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'uid', 'nama', 'nim', 'aktif', 'joinedAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.nama is string
          && request.resource.data.aktif == true
          && request.resource.data.joinedAt == request.time
          && (!('nim' in request.resource.data)
            || request.resource.data.nim is string)
          && uid in getAfter(
            /databases/$(database)/documents/kelas/$(classId)
          ).data.praktikanUids
          && uid in getAfter(
            /databases/$(database)/documents/praktikum/$(get(
              /databases/$(database)/documents/kelas/$(classId)
            ).data.praktikumId)
          ).data.praktikanUids;

        allow update: if assistantForClass(classId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nama', 'nim', 'aktif'
          ])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.nama is string
          && request.resource.data.aktif is bool
          && (!('nim' in request.resource.data)
            || request.resource.data.nim is string);

        allow delete: if false;
      }
    }

    match /jadwal/{jadwalId} {
      allow read: if assistantForClass(resource.data.kelasId)
        || practikanInClass(resource.data.kelasId);

      allow create: if assistantForClass(request.resource.data.kelasId)
        && validJadwal(request.resource.data);

      allow update: if assistantForClass(resource.data.kelasId)
        && request.resource.data.kelasId == resource.data.kelasId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pertemuanKe', 'tanggal', 'jamMulai', 'jamSelesai', 'lokasi', 'aktif'
        ])
        && validJadwal(request.resource.data);

      allow delete: if false;
    }

    match /sesi/{sesiId} {
      allow read: if assistantForClass(resource.data.kelasId)
        || practikanInClass(resource.data.kelasId);

      allow create: if assistantForClass(request.resource.data.kelasId)
        && request.resource.data.keys().hasAll([
          'jadwalId', 'kelasId', 'status', 'catatan', 'openedAt', 'closedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'jadwalId', 'kelasId', 'status', 'catatan', 'openedAt', 'closedAt'
        ])
        && request.resource.data.jadwalId is string
        && request.resource.data.status == 'belum_dibuka'
        && request.resource.data.catatan is string
        && request.resource.data.openedAt == null
        && request.resource.data.closedAt == null;

      allow update: if assistantForClass(resource.data.kelasId)
        && request.resource.data.jadwalId == resource.data.jadwalId
        && request.resource.data.kelasId == resource.data.kelasId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'catatan', 'openedAt', 'closedAt'
        ])
        && (
          (resource.data.status == 'belum_dibuka'
            && request.resource.data.status == 'dibuka'
            && request.resource.data.openedAt == request.time
            && request.resource.data.closedAt == null)
          || (resource.data.status == 'dibuka'
            && request.resource.data.status == 'ditutup'
            && request.resource.data.openedAt == resource.data.openedAt
            && request.resource.data.closedAt == request.time)
          || (resource.data.status == request.resource.data.status
            && resource.data.status != 'ditutup'
            && request.resource.data.catatan is string
            && request.resource.data.openedAt == resource.data.openedAt
            && request.resource.data.closedAt == resource.data.closedAt)
        );

      allow delete: if false;

      match /presensi/{uid} {
        allow get: if (isPractikan()
            && request.auth.uid == uid
            && resource.data.userId == uid
            && practikanInSession(sesiId))
          || assistantForSession(sesiId);
        allow list: if assistantForSession(sesiId);

        // Presensi creation remains blocked pending the approved code-validation design.
        allow create, update, delete: if false;
      }

      match /pengajuanIzin/{uid} {
        allow get: if (isPractikan()
            && request.auth.uid == uid
            && resource.data.userId == uid
            && practikanInSession(sesiId))
          || assistantForSession(sesiId);
        allow list: if assistantForSession(sesiId);

        allow create: if validPengajuanCreate(uid, sesiId);

        allow update: if assistantForSession(sesiId)
          && resource.data.status == 'menunggu'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reviewedBy', 'reviewedAt'
          ])
          && request.resource.data.status in ['diterima', 'ditolak']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && (request.resource.data.status != 'diterima'
            || !exists(
              /databases/$(database)/documents/sesi/$(sesiId)/presensi/$(uid)
            ));

        allow delete: if false;
      }
    }

    match /kodePresensi/{sesiId} {
      allow get: if assistantForSession(sesiId);
      allow list: if false;

      allow create, update: if assistantForSession(sesiId)
        && get(
          /databases/$(database)/documents/sesi/$(sesiId)
        ).data.status != 'ditutup'
        && request.resource.data.keys().hasAll(['kode', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['kode', 'updatedAt'])
        && request.resource.data.kode is string
        && request.resource.data.kode.matches('^[0-9]{4}$')
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
