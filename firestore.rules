rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- fungsi bantu ----------
    function signedIn() {
      return request.auth != null;
    }

    function profil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAsisten() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profil().role == 'asisten';
    }

    function kelasDoc(kelasId) {
      return get(/databases/$(database)/documents/kelas/$(kelasId)).data;
    }

    function asistenKelas(kelasId) {
      return isAsisten() && request.auth.uid in kelasDoc(kelasId).asistenUids;
    }

    function pesertaKelas(kelasId) {
      return signedIn()
        && exists(/databases/$(database)/documents/kelas/$(kelasId)/peserta/$(request.auth.uid));
    }

    function kelasSesi(sesiId) {
      return get(/databases/$(database)/documents/sesi/$(sesiId)).data.kelasId;
    }

    // ---------- users ----------
    match /users/{userId} {
        allow read: if signedIn()
            && (request.auth.uid == userId || isAsisten());
            // && (request.auth.uid == userId
            //     || (isAsisten() && resource.data.role == 'praktikan'));

      // pendaftaran: hanya boleh jadi praktikan
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'praktikan';

      // update: role tidak boleh berubah
      allow update: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // ---------- praktikum ----------
    match /praktikum/{praktikumId} {
      allow read: if signedIn();
      allow create, update: if isAsisten();
      allow delete: if isAsisten();
    }

    // ---------- kelas ----------
    match /kelas/{kelasId} {
      allow read: if isAsisten() || pesertaKelas(kelasId);

      // saat membuat, UID pembuat harus ada di asistenUids
      allow create: if isAsisten()
                    && request.auth.uid in request.resource.data.asistenUids;

      allow update, delete: if asistenKelas(kelasId);

      match /peserta/{uid} {
        allow read: if request.auth.uid == uid || asistenKelas(kelasId);
        allow create, update, delete: if asistenKelas(kelasId);
      }
    }

    // ---------- jadwal ----------
    match /jadwal/{jadwalId} {
      allow read: if isAsisten() || pesertaKelas(resource.data.kelasId);
      allow create: if asistenKelas(request.resource.data.kelasId);
      allow update, delete: if asistenKelas(resource.data.kelasId);
    }

    // ---------- sesi ----------
    match /sesi/{sesiId} {
      allow read: if isAsisten() || pesertaKelas(resource.data.kelasId);
      allow create: if asistenKelas(request.resource.data.kelasId);

      // sesi yang sudah ditutup tidak boleh dibuka lagi
      allow update: if asistenKelas(resource.data.kelasId)
                    && !(resource.data.status == 'ditutup'
                         && request.resource.data.status != 'ditutup');

      // hanya sesi belum_dibuka yang boleh dihapus
      allow delete: if asistenKelas(resource.data.kelasId)
                    && resource.data.status == 'belum_dibuka';

      // presensi
      match /presensi/{uid} {
        allow read: if request.auth.uid == uid
                    || asistenKelas(kelasSesi(sesiId));
        // praktikan: hanya dokumen sendiri, sesi dibuka, satu kali (path = UID)
        allow create: if signedIn()
                      && request.auth.uid == uid
                      && request.resource.data.userId == uid
                      && pesertaKelas(kelasSesi(sesiId))
                      && get(/databases/$(database)/documents/sesi/$(sesiId)).data.status == 'dibuka'
                      && !exists(/databases/$(database)/documents/sesi/$(sesiId)/pengajuanIzin/$(uid))
                         || (request.auth.uid == uid
                             && get(/databases/$(database)/documents/sesi/$(sesiId)/pengajuanIzin/$(uid)).data.status != 'diterima'
                             && false);
        allow update, delete: if false;
      }

      // pengajuan izin
      match /pengajuanIzin/{uid} {
        allow read: if request.auth.uid == uid
                    || asistenKelas(kelasSesi(sesiId));
        allow create: if signedIn()
                      && request.auth.uid == uid
                      && request.resource.data.userId == uid
                      && request.resource.data.status == 'menunggu'
                      && pesertaKelas(kelasSesi(sesiId))
                      && !exists(/databases/$(database)/documents/sesi/$(sesiId)/presensi/$(uid));
        // asisten memutuskan; praktikan tidak boleh mengubah
        allow update: if asistenKelas(kelasSesi(sesiId))
                      && resource.data.status == 'menunggu'
                      && request.resource.data.status in ['diterima', 'ditolak']
                      && !(request.resource.data.status == 'diterima'
                           && exists(/databases/$(database)/documents/sesi/$(sesiId)/presensi/$(uid)));
        allow delete: if false;
      }
    }

    // ---------- kode presensi (hanya asisten kelas) ----------
    match /kodePresensi/{sesiId} {
      allow read, write: if asistenKelas(kelasSesi(sesiId));
    }

    // ---------- semua yang lain ditolak ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}