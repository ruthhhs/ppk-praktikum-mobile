rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- fungsi bantu ----------
    // Memastikan request berasal dari pengguna yang sudah login.
    function signedIn() {
      return request.auth != null;
    }

    // Memeriksa role dari profil Firestore, bukan dari data yang dikirim client.
    function isAsisten() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'asisten';
    }

    function isPraktikan() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'praktikan';
    }

    // Path dokumen dipusatkan di helper agar konsisten dipakai oleh Rules lain.
    function classPath(kelasId) {
      return /databases/$(database)/documents/kelas/$(kelasId);
    }

    function participantPath(kelasId, uid) {
      return /databases/$(database)/documents/kelas/$(kelasId)/peserta/$(uid);
    }

    function sessionPath(sesiId) {
      return /databases/$(database)/documents/sesi/$(sesiId);
    }

    function attendancePath(sesiId, uid) {
      return /databases/$(database)/documents/sesi/$(sesiId)/presensi/$(uid);
    }

    function leavePath(sesiId, uid) {
      return /databases/$(database)/documents/sesi/$(sesiId)/pengajuanIzin/$(uid);
    }

    function attendanceCodePath(sesiId) {
      return /databases/$(database)/documents/kodePresensi/$(sesiId);
    }

    // Asisten hanya dapat mengelola kelas yang UID-nya tercatat di asistenUids.
    function assistantOwnsClass(kelasId) {
      return isAsisten()
        && exists(classPath(kelasId))
        && get(classPath(kelasId)).data.asistenUids is list
        && request.auth.uid in get(classPath(kelasId)).data.asistenUids;
    }

    // Praktikan harus terdaftar dan masih aktif pada kelas tersebut.
    function activeParticipant(kelasId, uid) {
      return isPraktikan()
        && exists(classPath(kelasId))
        && get(classPath(kelasId)).data.aktif != false
        && exists(participantPath(kelasId, uid))
        && get(participantPath(kelasId, uid)).data.aktif == true;
    }

    function participantBelongsToClass(kelasId, uid) {
      return isPraktikan()
        && exists(classPath(kelasId))
        && exists(participantPath(kelasId, uid))
        && get(participantPath(kelasId, uid)).data.uid == uid;
    }

    // Keanggotaan cukup untuk membaca identitas kelas; akses operasional
    // tetap mensyaratkan peserta dan kelas berstatus aktif.
    function praktikanTerkaitKelas(kelasId) {
      return participantBelongsToClass(kelasId, request.auth.uid);
    }

    function sessionIsOpen(sesiId) {
      return exists(sessionPath(sesiId))
        && get(sessionPath(sesiId)).data.status == 'dibuka';
    }

    function leaveAlreadyAccepted(sesiId, uid) {
      return exists(leavePath(sesiId, uid))
        && get(leavePath(sesiId, uid)).data.status == 'diterima';
    }

    // Perubahan detail sesi tidak boleh mengubah waktu/status sesi.
    function sessionStateUnchanged() {
      return request.resource.data.status == resource.data.status
        && request.resource.data.get('openedAt', null) == resource.data.get('openedAt', null)
        && request.resource.data.get('closedAt', null) == resource.data.get('closedAt', null);
    }

    // Transisi yang sah hanya belum_dibuka -> dibuka -> ditutup.
    function validSessionStateTransition() {
      return (
          resource.data.status == 'belum_dibuka'
        && resource.data.get('aktif', true) != false
          && request.resource.data.status == 'dibuka'
          && request.resource.data.openedAt == request.time
          && request.resource.data.get('closedAt', null) == resource.data.get('closedAt', null)
          && request.resource.data.get('aktif', true) == resource.data.get('aktif', true)
        )
        || (
          resource.data.status == 'dibuka'
          && resource.data.get('aktif', true) != false
          && request.resource.data.status == 'ditutup'
          && request.resource.data.closedAt == request.time
          && request.resource.data.get('openedAt', null) == resource.data.get('openedAt', null)
          && request.resource.data.get('aktif', true) == resource.data.get('aktif', true)
        );
    }

    // Sesi hanya boleh dinonaktifkan sebelum dibuka; dokumen tidak dihapus.
    function validSessionArchive() {
      return resource.data.status == 'belum_dibuka'
        && request.resource.data.status == 'belum_dibuka'
        && resource.data.get('aktif', true) != false
        && request.resource.data.get('aktif', true) == false
        && request.resource.data.get('openedAt', null) == resource.data.get('openedAt', null)
        && request.resource.data.get('closedAt', null) == resource.data.get('closedAt', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aktif']);
    }

    // ---------- users ----------
    // Pengguna hanya dapat membaca profil sendiri; asisten dapat membaca profil praktikan.
    match /users/{userId} {
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || (isAsisten() && resource.data.role == 'praktikan')
        );

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'nama', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'nama', 'email', 'role', 'nim', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.role == 'praktikan'
        && request.resource.data.createdAt == request.time
        && (!('nim' in request.resource.data) || request.resource.data.nim is string);

      allow update, delete: if false;
    }

    // ---------- praktikum ----------
    // Perubahan data praktikum dibatasi untuk asisten; hard-delete ditolak.
    match /praktikum/{praktikumId} {
      allow read: if isAsisten()
        || (
          isPraktikan()
          && resource.data.praktikanUids is list
          && request.auth.uid in resource.data.praktikanUids
        );

      allow create: if isAsisten()
        && request.resource.data.keys().hasAll([
          'nama', 'deskripsi', 'aktif', 'praktikanUids', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'nama', 'deskripsi', 'aktif', 'praktikanUids', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.nama is string
        && request.resource.data.deskripsi is string
        && request.resource.data.aktif is bool
        && request.resource.data.praktikanUids is list
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAsisten()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nama', 'deskripsi', 'aktif', 'praktikanUids', 'updatedAt'
        ])
        && request.resource.data.nama is string
        && request.resource.data.deskripsi is string
        && request.resource.data.aktif is bool
        && request.resource.data.praktikanUids is list
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------- kelas dan peserta ----------
    match /kelas/{kelasId} {
      allow read: if isAsisten()
        || praktikanTerkaitKelas(kelasId);

      // Saat membuat kelas, asisten pembuat harus menjadi satu-satunya asisten awal.
      allow create: if isAsisten()
        && request.resource.data.keys().hasAll([
          'praktikumId', 'nama', 'asistenUids', 'praktikanUids',
          'aktif', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'praktikumId', 'nama', 'asistenUids', 'praktikanUids',
          'aktif', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.praktikumId is string
        && request.resource.data.nama is string
        && request.resource.data.asistenUids is list
        && request.resource.data.asistenUids.size() == 1
        && request.auth.uid in request.resource.data.asistenUids
        && request.resource.data.praktikanUids is list
        && request.resource.data.aktif is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if assistantOwnsClass(kelasId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'praktikumId', 'nama', 'asistenUids', 'praktikanUids',
          'aktif', 'updatedAt'
        ])
        && request.resource.data.asistenUids == resource.data.asistenUids
        && request.auth.uid in request.resource.data.asistenUids
        && request.resource.data.praktikumId is string
        && request.resource.data.nama is string
        && request.resource.data.praktikanUids is list
        && request.resource.data.aktif is bool
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /peserta/{uid} {
        allow read: if (isPraktikan() && request.auth.uid == uid)
          || assistantOwnsClass(kelasId);

        allow create: if assistantOwnsClass(kelasId)
            && exists(/databases/$(database)/documents/users/$(uid))
            && get(/databases/$(database)/documents/users/$(uid)).data.role == 'praktikan'
          && request.resource.data.keys().hasAll(['uid', 'nama', 'aktif', 'joinedAt'])
          && request.resource.data.keys().hasOnly(['uid', 'nama', 'nim', 'aktif', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.nama is string
          && request.resource.data.aktif == true
          && request.resource.data.joinedAt == request.time
          && (!('nim' in request.resource.data) || request.resource.data.nim is string);

        allow update: if assistantOwnsClass(kelasId)
          && request.resource.data.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aktif'])
          && request.resource.data.aktif is bool;

        allow delete: if false;
      }
    }

    // Collection-group query untuk menemukan kelas dari dokumen keanggotaan sendiri.
    match /{path=**}/peserta/{uid} {
      allow get, list: if isPraktikan()
        && resource.data.uid == request.auth.uid;
    }

    // ---------- jadwal ----------
    match /jadwal/{jadwalId} {
      allow read: if isAsisten()
        || (isPraktikan() && activeParticipant(resource.data.kelasId, request.auth.uid));

      allow create: if assistantOwnsClass(request.resource.data.kelasId)
        && request.resource.data.keys().hasAll([
          'kelasId', 'pertemuanKe', 'tanggal', 'jamMulai',
          'jamSelesai', 'lokasi', 'aktif'
        ])
        && request.resource.data.keys().hasOnly([
          'kelasId', 'pertemuanKe', 'tanggal', 'jamMulai',
          'jamSelesai', 'lokasi', 'aktif'
        ])
        && request.resource.data.pertemuanKe is int
        && request.resource.data.pertemuanKe >= 1
        && request.resource.data.tanggal is string
        && request.resource.data.jamMulai is string
        && request.resource.data.jamSelesai is string
        && request.resource.data.lokasi is string
        && request.resource.data.aktif is bool;

      allow update: if assistantOwnsClass(resource.data.kelasId)
        && assistantOwnsClass(request.resource.data.kelasId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'kelasId', 'pertemuanKe', 'tanggal', 'jamMulai',
          'jamSelesai', 'lokasi', 'aktif'
        ])
        && request.resource.data.pertemuanKe is int
        && request.resource.data.pertemuanKe >= 1
        && request.resource.data.tanggal is string
        && request.resource.data.jamMulai is string
        && request.resource.data.jamSelesai is string
        && request.resource.data.lokasi is string
        && request.resource.data.aktif is bool;

      allow delete: if false;
    }

    // ---------- sesi ----------
    match /sesi/{sesiId} {
      allow read: if isAsisten()
        || (isPraktikan() && activeParticipant(resource.data.kelasId, request.auth.uid));

      allow create: if assistantOwnsClass(request.resource.data.kelasId)
        && request.resource.data.keys().hasAll([
          'jadwalId', 'kelasId', 'status', 'catatan', 'openedAt', 'closedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'jadwalId', 'kelasId', 'praktikumId', 'praktikum',
          'pertemuanKe', 'kelas', 'lab', 'lokasi', 'tanggal',
          'jamMulai', 'jamSelesai', 'status', 'catatan',
          'openedAt', 'closedAt', 'aktif'
        ])
        && request.resource.data.status == 'belum_dibuka'
        && request.resource.data.openedAt == null
        && request.resource.data.closedAt == null
        && request.resource.data.get('aktif', true) == true;

      // Perubahan sesi harus tetap di kelas milik asisten dan mengikuti
      // transisi status yang sah atau pengarsipan sebelum sesi dibuka.
      allow update: if assistantOwnsClass(resource.data.kelasId)
        && assistantOwnsClass(request.resource.data.kelasId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'jadwalId', 'kelasId', 'praktikumId', 'praktikum',
          'pertemuanKe', 'kelas', 'lab', 'lokasi', 'tanggal',
          'jamMulai', 'jamSelesai', 'status', 'catatan',
          'openedAt', 'closedAt', 'aktif'
        ])
        && request.resource.data.status in ['belum_dibuka', 'dibuka', 'ditutup']
        && (
          (
            resource.data.status == 'belum_dibuka'
            && resource.data.get('aktif', true) != false
            && request.resource.data.status == 'belum_dibuka'
            && sessionStateUnchanged()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aktif'])
          )
          || validSessionStateTransition()
          || validSessionArchive()
        );

      allow delete: if false;

      // ---------- presensi ----------
      // Presensi hanya sekali, oleh praktikan sendiri, saat sesi dibuka,
      // dengan kode 4 digit yang sama dengan kode milik sesi.
      match /presensi/{uid} {
        allow read: if (isPraktikan() && request.auth.uid == uid)
          || assistantOwnsClass(get(sessionPath(sesiId)).data.kelasId);

        allow create: if isPraktikan()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['userId', 'recordedAt', 'kode'])
          && request.resource.data.keys().hasOnly(['userId', 'recordedAt', 'kode'])
          && request.resource.data.userId == uid
          && request.resource.data.recordedAt == request.time
          && request.resource.data.kode is string
          && request.resource.data.kode.matches('^[0-9]{4}$')
          && sessionIsOpen(sesiId)
          && activeParticipant(get(sessionPath(sesiId)).data.kelasId, uid)
          && exists(attendanceCodePath(sesiId))
          && request.resource.data.kode == get(attendanceCodePath(sesiId)).data.kode
          && !leaveAlreadyAccepted(sesiId, uid);

        allow update, delete: if false;
      }

      // ---------- pengajuan izin ----------
      match /pengajuanIzin/{uid} {
        allow read: if (isPraktikan() && request.auth.uid == uid)
          || assistantOwnsClass(get(sessionPath(sesiId)).data.kelasId);

        allow create: if isPraktikan()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll([
            'userId', 'alasan', 'statusKlasifikasi', 'status', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'userId', 'alasan', 'kategoriAI', 'statusKlasifikasi',
            'status', 'createdAt'
          ])
          && request.resource.data.userId == uid
          && request.resource.data.alasan is string
          && request.resource.data.alasan.size() >= 10
          && request.resource.data.alasan.size() <= 500
          && request.resource.data.statusKlasifikasi in ['berhasil', 'gagal']
          && (!('kategoriAI' in request.resource.data) || request.resource.data.kategoriAI is string)
          && request.resource.data.status == 'menunggu'
          && request.resource.data.createdAt == request.time
          && exists(sessionPath(sesiId))
          && get(sessionPath(sesiId)).data.status in ['belum_dibuka', 'dibuka']
          && activeParticipant(get(sessionPath(sesiId)).data.kelasId, uid)
          && !exists(attendancePath(sesiId, uid))
          && !exists(leavePath(sesiId, uid));

        allow update: if assistantOwnsClass(get(sessionPath(sesiId)).data.kelasId)
          && resource.data.status == 'menunggu'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reviewedBy', 'reviewedAt'
          ])
          && request.resource.data.status in ['diterima', 'ditolak']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && (
            request.resource.data.status != 'diterima'
            || !exists(attendancePath(sesiId, uid))
          );

        allow delete: if false;
      }
    }

    // ---------- kode presensi (khusus asisten kelas) ----------
    match /kodePresensi/{sesiId} {
      allow read: if assistantOwnsClass(get(sessionPath(sesiId)).data.kelasId);

      allow create, update: if assistantOwnsClass(get(sessionPath(sesiId)).data.kelasId)
        && get(sessionPath(sesiId)).data.status in ['belum_dibuka', 'dibuka']
        && get(sessionPath(sesiId)).data.get('aktif', true) != false
        && request.resource.data.keys().hasAll(['kode', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['kode', 'updatedAt'])
        && request.resource.data.kode is string
        && request.resource.data.kode.matches('^[0-9]{4}$')
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------- semua dokumen lain ditolak ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
